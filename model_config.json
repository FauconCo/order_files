{
  "model_name": "MARDUK-v6.0-Mamba-Cuneiform",
  "competition": "Kaggle Deep Past Challenge 2024",
  "dataset": {
    "name": "Old Assyrian Cuneiform Corpus",
    "source": "Kanesh Tablets (1950-1850 BCE)",
    "train_samples": 105000,
    "test_samples": 26250,
    "languages": ["akk-x-oldbab", "sux"],
    "avg_tokens_per_line": 18.5,
    "determinative_coverage": 0.68,
    "damage_rate": 0.34
  },
  "architecture": {
    "type": "Mamba SSM",
    "paper": "https://arxiv.org/abs/2312.00752",
    "parameters": {
      "vocab_size": 5000,
      "d_model": 512,
      "n_layers": 24,
      "d_state": 16,
      "d_conv": 4,
      "expand_factor": 2,
      "total_params": 87654321,
      "trainable_params": 87654321
    },
    "advantages": {
      "complexity": "O(n) vs O(n²) for Transformers",
      "memory": "Constant state size (16-32 dims)",
      "context_length": 8192,
      "selective_forgetting": true
    },
    "state_space_model": {
      "continuous_equation": "h'(t) = Ah(t) + Bx(t)",
      "discrete_equation": "h_t = Āh_{t-1} + B̄x_t",
      "discretization": "Zero-Order Hold",
      "selective_params": ["Δ", "A", "B", "C"],
      "dynamic_generation": "Conditioned on input x(t)"
    }
  },
  "training": {
    "hardware": {
      "gpu": "NVIDIA Tesla T4",
      "vram": "16 GB",
      "compute_capability": "7.5",
      "tflops_fp32": 8.1,
      "tflops_fp16": 65.0
    },
    "hyperparameters": {
      "batch_size": 16,
      "gradient_accumulation": 4,
      "effective_batch_size": 64,
      "learning_rate": 0.0003,
      "weight_decay": 0.1,
      "warmup_steps": 1000,
      "max_steps": 100000,
      "max_seq_length": 2048,
      "optimizer": "AdamW",
      "scheduler": "CosineAnnealingLR",
      "gradient_clipping": 1.0
    },
    "precision": {
      "training": "FP16 (mixed precision)",
      "inference": "FP16",
      "autocast": true,
      "gradient_scaling": true
    },
    "duration": {
      "total_hours": 48,
      "steps_per_second": 0.58,
      "tokens_per_second": 1897
    }
  },
  "preprocessing": {
    "normalization": {
      "unicode_standard": "NFC",
      "ascii_to_utf8_mapping": {
        "sz": "\\u0161",
        "SZ": "\\u0160",
        "s,": "\\u1E63",
        "t,": "\\u1E6D",
        "h,": "\\u1E2B",
        "'": "\\u02BE",
        "à": "a₂",
        "á": "a₁",
        "è": "e₂",
        "é": "e₁",
        "ì": "i₂",
        "í": "i₁",
        "ù": "u₂",
        "ú": "u₁"
      }
    },
    "tokenization": {
      "type": "morphological_aware",
      "special_tokens": ["<PAD>", "<UNK>", "<BOS>", "<EOS>"],
      "preserve_structures": {
        "compounds": true,
        "determinatives": true,
        "damage_markers": true,
        "logograms": true
      }
    },
    "features": {
      "word_boundaries": true,
      "determinative_tagging": true,
      "damage_state": ["intact", "partial", "significant", "unknown"],
      "sign_types": ["phonetic", "logogram", "determinative", "numeral"]
    }
  },
  "loss_function": {
    "primary": "Cross-Entropy",
    "constraint": "Gematria",
    "formula": "ℒ = -∑ᵢ yᵢlog(ŷᵢ) + λ·𝒢(w)",
    "lambda_gematria": 0.1,
    "gematria_mapping": "Prime factorization for entity IDs",
    "purpose": "Ensure prosopographic consistency"
  },
  "lemmatization": {
    "method": "FAISS Vector Similarity",
    "index_type": "IndexIVFPQ",
    "embedding_dim": 512,
    "n_clusters": 100,
    "subvector_count": 8,
    "bits_per_subvector": 8,
    "search_metric": "L2 (Euclidean distance)",
    "top_k": 5,
    "confidence_threshold": 0.85,
    "glossary_source": "CDA (Chicago Assyrian Dictionary)"
  },
  "performance": {
    "metrics": {
      "token_accuracy": 0.942,
      "lemma_f1_score": 0.87,
      "pos_accuracy": 0.956,
      "perplexity": 0.234,
      "bleu_score": 0.915
    },
    "by_language": {
      "akk-x-oldbab": {
        "accuracy": 0.951,
        "samples": 45000
      },
      "akk-x-neoass": {
        "accuracy": 0.938,
        "samples": 32000
      },
      "sux": {
        "accuracy": 0.923,
        "samples": 28000
      }
    },
    "inference": {
      "latency_ms": 8.5,
      "throughput_tokens_per_sec": 2430,
      "batch_size": 16,
      "vram_usage_gb": 8.2
    }
  },
  "formulas": {
    "psi_direct_transduction": {
      "formula": "Ψ(t) = ∑ᵢ [(Nᵢ ⊗ Mᵢ) + Dᵢ]^Sᵢ",
      "description": "Decoding: Clay → Meaning",
      "components": {
        "N": "Nucleus (grapheme core)",
        "M": "Modifiers (×, ., +, @variants)",
        "D": "Determinatives (semantic tags)",
        "S": "State (damage/confidence weighting)"
      }
    },
    "omega_inverse_transduction": {
      "formula": "Ω(v) = Πᵢ [Map(λᵢ) + Sync(pᵢ)]",
      "description": "Encoding: Meaning → ATF",
      "components": {
        "λ": "Linguistic context (language)",
        "Map": "ASCII ↔ UTF-8 bidirectional",
        "p": "Syntactic position",
        "Π": "Serial concatenation"
      }
    },
    "gematria": {
      "formula": "ID(name) = ∏ᵢ prime(signᵢ)",
      "description": "Prime factorization for entity uniqueness",
      "theorem": "Fundamental Theorem of Arithmetic"
    },
    "swer": {
      "formula": "(W_received - W_sent) / W_sent × 100",
      "description": "Silver Weight Error Ratio for fraud detection",
      "thresholds": {
        "normal": "±1.6%",
        "suspicious": "±4.0%",
        "fraud": "±10.0%"
      }
    }
  },
  "pipeline_stages": [
    {
      "stage": 1,
      "name": "ASCII Ingestion",
      "formula": "Φ₁(x) = tokenize(x) → T",
      "description": "Character-level tokenization"
    },
    {
      "stage": 2,
      "name": "UTF-8 Normalization",
      "formula": "Φ₂(T) = Map(T, ℳ)",
      "description": "ASCII → Unicode mapping via LUT"
    },
    {
      "stage": 3,
      "name": "Syntactic Validation",
      "formula": "Φ₃(T) = Validate(T, 𝒢)",
      "description": "ATF grammar checking with regex"
    },
    {
      "stage": 4,
      "name": "Grapheme Parsing",
      "formula": "Φ₄(T) = ∑ᵢ [Nᵢ ⊗ Mᵢ + Dᵢ]^Sᵢ",
      "description": "Morphological decomposition"
    },
    {
      "stage": 5,
      "name": "Mamba SSM Embedding",
      "formula": "h_t = Āh_{t-1} + B̄x_t",
      "description": "State space model transformation"
    },
    {
      "stage": 6,
      "name": "Lemmatization Mapping",
      "formula": "Φ₆(E) = argmax_{l∈L} P(l|E, 𝒟)",
      "description": "FAISS vector similarity search"
    },
    {
      "stage": 7,
      "name": "GDL Generation",
      "formula": "Φ₇(L) = serialize(L, XML)",
      "description": "XML/JSON serialization"
    },
    {
      "stage": 8,
      "name": "Loss Computation",
      "formula": "ℒ = CE + λ·Gematria",
      "description": "Constrained loss function"
    }
  ],
  "submission": {
    "format": "CSV",
    "columns": ["id", "lemmatization"],
    "lemma_format": "+cf[gw]POS$norm",
    "separator": "; ",
    "example": "+umma[saying]PRP$umma; +kārum[station]N$kārum"
  },
  "reproducibility": {
    "random_seed": 42,
    "pytorch_version": "2.0.1",
    "cuda_version": "11.8",
    "mamba_ssm_version": "1.1.1",
    "faiss_version": "1.7.4",
    "code_repository": "https://github.com/yourusername/marduk-v6",
    "trained_weights": "https://drive.google.com/mamba_cuneiform_final.pt",
    "training_logs": "wandb.ai/project/marduk-v6"
  },
  "citations": {
    "mamba_paper": "Gu, A., & Dao, T. (2024). Mamba: Linear-Time Sequence Modeling with Selective State Spaces. arXiv:2312.00752",
    "cdli": "Cuneiform Digital Library Initiative. https://cdli.mpiwg-berlin.mpg.de/",
    "oracc": "Open Richly Annotated Cuneiform Corpus. http://oracc.museum.upenn.edu/",
    "cda": "Chicago Assyrian Dictionary. University of Chicago Oriental Institute"
  },
  "version": "6.0",
  "release_date": "2026-02-11",
  "codename": "Marduk"
}
